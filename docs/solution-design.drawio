<mxfile host="app.diagrams.net">
  <diagram id="solution-design" name="Solution design">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Azure APIM demo - solution design (clients &#8594; APIM / AI Gateway &#8594; Function App)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="5" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- Clients -->
        <mxCell id="c1" value="&lt;b&gt;REST client&lt;/b&gt;&lt;br&gt;curl / apps / tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;MCP client&lt;/b&gt;&lt;br&gt;VS Code Copilot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Workspace consumer&lt;/b&gt;&lt;br&gt;Products team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;AI agent / MCP client&lt;/b&gt;&lt;br&gt;via AI Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Resource group -->
        <mxCell id="rg" value="Azure resource group (BASE_NAME)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=none;strokeColor=#0078d4;dashed=1;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="1200" height="720" as="geometry" />
        </mxCell>

        <!-- APIM -->
        <mxCell id="apim" value="API Management &#8212; apim-&amp;lt;BASE_NAME&amp;gt; (StandardV2)  [platform team]" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="290" y="90" width="520" height="410" as="geometry" />
        </mxCell>
        <mxCell id="apim-api" value="&lt;b&gt;REST API&lt;/b&gt; products-api&lt;br&gt;path /products-api&lt;br&gt;&lt;i&gt;(swagger.json, api.bicep)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="310" y="130" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="apim-mcp" value="&lt;b&gt;MCP server&lt;/b&gt; products-mcp&lt;br&gt;path /products-mcp/mcp&lt;br&gt;&lt;i&gt;(passthrough, api.bicep)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="310" y="230" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="apim-prod" value="&lt;b&gt;Products &amp;amp; subscriptions&lt;/b&gt;&lt;br&gt;demo, ... + demo-tests key&lt;br&gt;&lt;i&gt;(apim-config.json, access.bicep)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="540" y="130" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="apim-pol" value="&lt;b&gt;Inbound policy&lt;/b&gt;&lt;br&gt;validate subscription key (401)&lt;br&gt;rate-limit&lt;br&gt;set x-functions-key (named value)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="540" y="230" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ws" value="APIM workspace products-team  [integration team]" style="swimlane;whiteSpace=wrap;html=1;startSize=24;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="310" y="330" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ws-api" value="&lt;b&gt;REST API&lt;/b&gt; products-team-products-api&lt;br&gt;path /ws-products-api&lt;br&gt;own named value, policy,&lt;br&gt;product + subscription" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="365" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="ws-note" value="&lt;i&gt;Workspaces don't support MCP, so the MCP server stays at service level&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="375" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- AI Gateway -->
        <mxCell id="aigw" value="Azure AI Gateway (preview) &#8212; aigw-&amp;lt;BASE_NAME&amp;gt;  [platform team]" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="290" y="540" width="520" height="190" as="geometry" />
        </mxCell>
        <mxCell id="aigw-tool" value="&lt;b&gt;Tool server&lt;/b&gt; products (namespace products_*)&lt;br&gt;/default/toolservers/products/mcp&lt;br&gt;&lt;i&gt;(aigateway-mcp.bicep, integration team)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="310" y="580" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aigw-key" value="&lt;b&gt;Runtime API key&lt;/b&gt;&lt;br&gt;products-mcp-client&lt;br&gt;(Bearer token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="600" y="580" width="190" height="80" as="geometry" />
        </mxCell>

        <!-- Function App -->
        <mxCell id="func" value="Function App &#8212; func-&amp;lt;BASE_NAME&amp;gt; (Node.js v4)  [apps team]" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="930" y="90" width="500" height="300" as="geometry" />
        </mxCell>
        <mxCell id="func-rest" value="&lt;b&gt;REST API&lt;/b&gt; (functions/api.js)&lt;br&gt;GET /api/health&lt;br&gt;GET, POST /api/products&lt;br&gt;GET, PUT, DELETE /api/products/{id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="950" y="130" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="func-mcp" value="&lt;b&gt;MCP endpoint&lt;/b&gt; (functions/mcp.js)&lt;br&gt;POST /api/mcp (Streamable HTTP)&lt;br&gt;tools: getHealth, listProducts, getProduct, createProduct, updateProduct, deleteProduct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1190" y="130" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="func-store" value="In-memory product store (store.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="950" y="260" width="460" height="40" as="geometry" />
        </mxCell>
        <mxCell id="func-auth" value="authLevel: function &#8212; requires x-functions-key host key; code deployed by workflow 31" style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="950" y="310" width="460" height="30" as="geometry" />
        </mxCell>

        <!-- Supporting resources -->
        <mxCell id="plan" value="&lt;b&gt;App Service plan&lt;/b&gt; plan-&amp;lt;BASE_NAME&amp;gt; (S1 Linux)&lt;br&gt;&lt;i&gt;integration team, plan.bicep&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="930" y="430" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vnet" value="&lt;b&gt;VNet + private endpoints&lt;/b&gt; vnet-&amp;lt;BASE_NAME&amp;gt;&lt;br&gt;Function VNet integration, private DNS&lt;br&gt;&lt;i&gt;platform team&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1180" y="430" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="stor" value="&lt;b&gt;Storage account&lt;/b&gt; (identity-based, public access disabled)&lt;br&gt;blob / queue / table via private endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1180" y="520" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="appi" value="&lt;b&gt;Application Insights&lt;/b&gt; + Log Analytics&lt;br&gt;telemetry from APIM and Function App&lt;br&gt;&lt;i&gt;platform team&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="930" y="520" width="230" height="60" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="lg0" value="Owner" style="text;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="620" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="Platform team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="930" y="650" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="Apps team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1075" y="650" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="Integration team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1220" y="650" width="130" height="30" as="geometry" />
        </mxCell>

        <!-- Flows: clients to gateways -->
        <mxCell id="e1" value="Ocp-Apim-Subscription-Key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c1" target="apim-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Ocp-Apim-Subscription-Key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c2" target="apim-mcp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="workspace subscription key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c3" target="ws-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Authorization: Bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c4" target="aigw-tool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flows: gateways to backend -->
        <mxCell id="e6" value="x-functions-key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apim-pol" target="func-rest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="HTTPS /api/mcp (x-functions-key)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="aigw-key" target="func-mcp">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="880" y="620" />
              <mxPoint x="880" y="405" />
              <mxPoint x="1300" y="405" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Flows: backend internals -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="func-rest" target="func-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="func-mcp" target="func-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="hosted on" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=10;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="func" target="plan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="VNet integration" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;fontSize=10;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="func" target="vnet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;" edge="1" parent="1" source="vnet" target="stor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
